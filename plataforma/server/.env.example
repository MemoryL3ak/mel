# Copiar a .env y completar con el proyecto Supabase de la plataforma oficial.
# La clave secreta (sb_secret_...) NUNCA se comparte ni se sube al repositorio.
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Secreto para firmar los JWT de sesión (generar uno largo y aleatorio).
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio

# Puerto del servidor (la demo usa 4001; la plataforma oficial usa 4100).
PORT=4100

# Origenes permitidos para CORS cuando el frontend vive en otro dominio.
# Lista separada por comas. Vacio u omitido = solo mismo origen.
# CORS_ORIGIN=https://gea-mel.vercel.app

# Correo saliente del portal de obsoletos (registro, due diligence, ofertas,
# adjudicacion). OPCIONAL: sin proveedor, los correos quedan en el log y no se
# envian. La plataforma funciona igual.
#
# Preferente: Resend (https://resend.com). Verifica tu dominio de envio (agrega
# los registros DNS que te da) y crea una API key. MAIL_FROM debe ser una
# direccion de ese dominio.
# RESEND_API_KEY=re_...
# MAIL_FROM=GEA · Venta de obsoletos <no-reply@tu-dominio.cl>
# URL publica del portal para los enlaces de los correos.
# PORTAL_URL=https://venta.gea-escondida.cl
# URL de la plataforma interna para los avisos de vencimiento documental.
# Si se omite, se deduce de PORTAL_URL quitandole /portal.
# APP_URL=https://gea-mel.vercel.app
#
# Alternativa: SMTP (SES, Gmail, etc.) en vez de Resend.
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASS=...
